[Unit]
Description=Fire heartbeat-watchdog.service every 30 minutes
Requires=heartbeat-watchdog.service

[Timer]
# First run 6 minutes after boot (let the PPS stack + summarizer settle), then
# every 30 minutes. The check is cheap (read a few JSON markers) so cadence is
# generous; 30 min bounds worst-case "how long dark before Jeff is told" to
# ~3h30m, which is fine for a "you've been asleep" heads-up.
OnBootSec=6min
OnUnitActiveSec=30min
AccuracySec=1min
Persistent=true
Unit=heartbeat-watchdog.service

[Install]
WantedBy=timers.target
