[Unit]
Description=Caia SL Presence Daemon - self-contained Second Life brain + prim bridge
Documentation=file:///mnt/c/Users/Jeff/Claude_Projects/Awareness/work/sl-presence/spec.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

WorkingDirectory=/mnt/c/Users/Jeff/Claude_Projects/Awareness

Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONDONTWRITEBYTECODE=1"
Environment="ENTITY_NAME=caia"
Environment="ENTITY_TOKEN_FILE=/mnt/c/Users/Jeff/Claude_Projects/Awareness/entities/caia/.entity_token"
Environment="ENTITY_PATH=/mnt/c/Users/Jeff/Claude_Projects/Awareness/entities/caia"
Environment="PPS_HTTP_URL=http://localhost:8211"
Environment="CLAUDE_MODEL=claude-opus-4-8"
Environment="ANCHORAGE_SL_SECRET_FILE=/mnt/c/Users/Jeff/Claude_Projects/Awareness/haven/data/anchorage-sl-secret.txt"
Environment="SL_DAEMON_HOST=0.0.0.0"
Environment="SL_DAEMON_PORT=8221"

# Corrade notification receiver — OFF until Jeff flips it on with creds present.
# CORRADE_GROUP + the password file are the (group,password) auth; leave them here
# as the intended shape. CORRADE_EVENTS_BASE must be reachable by the Corrade
# container: under Docker Desktop/WSL2 that is host.docker.internal, not 127.0.0.1.
# CORRADE_BASE_URL points at Caia's OWN Corrade instance's HTTP server (distinct
# port from Lyra's if both run) — adjust when the second container is stood up.
Environment="SL_CORRADE=0"
Environment="CORRADE_BASE_URL=http://127.0.0.1:8081/"
Environment="CORRADE_GROUP=Haven"
Environment="CORRADE_PASSWORD_FILE=/mnt/c/Users/Jeff/Claude_Projects/Awareness/haven/data/corrade-group-password-caia.txt"
Environment="CORRADE_EVENTS_BASE=http://host.docker.internal:8221"
Environment="CORRADE_NOTIFY_TYPES=local,message,dialog,avatars,collision,sit,animation,appearance,balance,alert,typing,region"

ExecStart=/mnt/c/Users/Jeff/Claude_Projects/Awareness/.venv/bin/python3 -m haven.anchorage.sl_daemon

Restart=always
RestartSec=15
StartLimitInterval=300
StartLimitBurst=5

KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

MemoryMax=1024M
MemorySwapMax=512M
CPUQuota=50%

StandardOutput=journal
StandardError=journal
SyslogIdentifier=caia-sl

[Install]
WantedBy=default.target
