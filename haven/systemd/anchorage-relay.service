[Unit]
Description=The Anchorage - Second Life <-> Haven chat relay
Documentation=file:///mnt/c/Users/Jeff/Claude_Projects/Awareness/haven/anchorage/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

WorkingDirectory=/mnt/c/Users/Jeff/Claude_Projects/Awareness

Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONDONTWRITEBYTECODE=1"
Environment="HAVEN_URL=http://localhost:8205"
Environment="ANCHORAGE_ROOM=anchorage"
Environment="RELAY_HOST=0.0.0.0"
Environment="RELAY_PORT=8210"
Environment="ANCHORAGE_RELAY_TOKEN_FILE=/mnt/c/Users/Jeff/Claude_Projects/Awareness/haven/data/anchorage-relay.token"
Environment="ANCHORAGE_SL_SECRET_FILE=/mnt/c/Users/Jeff/Claude_Projects/Awareness/haven/data/anchorage-sl-secret.txt"

ExecStart=/mnt/c/Users/Jeff/Claude_Projects/Awareness/.venv/bin/python3 -m haven.anchorage.relay

Restart=always
RestartSec=15
StartLimitInterval=300
StartLimitBurst=5

KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

MemoryMax=256M
CPUQuota=25%

StandardOutput=journal
StandardError=journal
SyslogIdentifier=anchorage-relay

[Install]
WantedBy=default.target
